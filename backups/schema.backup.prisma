generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  ADMIN
}

enum MerchantRole {
  OWNER
  MANAGER
  STAFF
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  platformRole PlatformRole @default(USER)

  memberships MerchantMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Merchant {
  id           String           @id @default(cuid())
  businessName String
  memberships  MerchantMember[]
  stores       Store[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MerchantMember {
  id         String       @id @default(cuid())
  userId     String
  merchantId String
  role       MerchantRole @default(STAFF)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId, role])
}

model Store {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, isActive])
}
